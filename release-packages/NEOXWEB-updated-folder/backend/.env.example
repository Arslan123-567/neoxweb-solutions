# Nexura Backend — copy to .env and fill values
APP_ENV=local
APP_DEBUG=false
APP_FORCE_HTTPS=false
APP_BASE_URL=http://localhost/time/backend
FRONTEND_URL=http://localhost/time/project
CORS_ALLOWED_ORIGINS=https://neoxweb.com,https://www.neoxweb.com,http://localhost,http://127.0.0.1

# MySQL
DB_HOST=localhost
DB_NAME=nexura_db
DB_USER=root
DB_PASS=

# JWT / session (change in production)
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_TTL=604800

# Enable only for initial production setup; use a long random token.
APP_INSTALLER_ENABLED=false
INSTALL_TOKEN=
INITIAL_ADMIN_PASSWORD=

# Optional realtime server. Leave blank to disable realtime notifications.
REALTIME_URL=
REALTIME_SECRET=

# Token encryption key (32+ chars — used to encrypt Microsoft tokens at rest)
TOKEN_ENCRYPTION_KEY=change-this-32-char-minimum-secret-key!!

# Microsoft Azure AD / Graph OAuth 2.0
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost/time/backend/api/microsoft/callback.php

# Comma-separated delegated scopes (user consent required)
MICROSOFT_SCOPES=openid profile offline_access User.Read Mail.Read
